<?xml version="1.0" encoding="utf-8" ?>
		<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
		                   assembly="WinetrackerGen.Infraestructure"
		                   namespace="WinetrackerGen.Infraestructure.EN.Winetracker">
		    
		    
			
				<class name="UsuarioNH" table="Usuario"> 
						<id name="Id" column="attribute"/> 
			
					
					<property name="Nombre" type="string"> 
						<column name="nombre"  not-null="true"/>
					</property>
					<property name="Correo" type="string"> 
						<column name="correo"  unique="true" not-null="true"/>
					</property>
					<property name="Password" type="string"> 
						<column name="password"  not-null="true"/>
					</property>
					<property name="Foto" type="string"> 
						<column name="foto"  not-null="true"/>
					</property>
					<property name="Provincia" > 
						<column name="provincia"  not-null="true"/>
					</property>
			
			
			
			
			
			
			
		  			
						<bag name="Articulo_publicado" >
							<key>
							
								
								<column name="FK_attribute_idVendedor"/>
					      	</key>
							<one-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.ArticuloNH"/>
					    </bag>
					
			
		  			
						<bag name="Pedido_comprado" >
							<key>
							
								
								<column name="FK_attribute_idUsuario"/>
					      	</key>
							<one-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.PedidoNH"/>
					    </bag>
					
			
		  			
						<bag name="Articulo_favoritos" table="[articulo_0_usuario_0]" inverse="true" >
							<key>
								
									<column name="FK_attribute_idUsuarios_favoritos"/> 
							</key>
      						<many-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.ArticuloNH">
									<column name="FK_id_idArticulo_0"/> 
      						</many-to-many>
    					</bag>
			
		  			
						<bag name="Valoracion_usuario" >
							<key>
							
								
								<column name="FK_attribute_idUsuario"/>
					      	</key>
							<one-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.ValoracionNH"/>
					    </bag>
					
			
		  			
						<bag name="EsPuesto" >
							<key>
							
								
								<column name="FK_attribute_idUsuario"/>
					      	</key>
							<one-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.ComentarioNH"/>
					    </bag>
					
			
		  			
						<bag name="Megusta_0" >
							<key>
							
								
								<column name="FK_attribute_idUsuario"/>
					      	</key>
							<one-to-many class="WinetrackerGen.Infraestructure.EN.Winetracker.MegustaNH"/>
					    </bag>
					
			
					
					
					
					
					
					
					
					
					
					
					
					
		
		 </class>	
		  
		  <query name="UsuarioNHReadAllHQL">from UsuarioNH</query>
		</hibernate-mapping>
	