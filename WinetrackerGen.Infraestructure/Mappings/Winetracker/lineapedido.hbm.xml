<?xml version="1.0" encoding="utf-8" ?>
		<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
		                   assembly="WinetrackerGen.Infraestructure"
		                   namespace="WinetrackerGen.Infraestructure.EN.Winetracker">
		    
		    
			
				<class name="LineaPedidoNH" table="LineaPedido"> 
				  	
						<id name="Id" column="idLineaPedido" type="integer"> 
							<generator class="hilo"/>
						</id>
			
					
					<property name="Cantidad" type="integer"> 
						<column name="cantidad"  not-null="true"/>
					</property>
					<property name="Importe" type="float"> 
						<column name="importe"  not-null="true"/>
					</property>
			
			
		  			
						<many-to-one name="Pedido_tiene" class="WinetrackerGen.Infraestructure.EN.Winetracker.PedidoNH" >	
								<column name="FK_idPedido_idPedido"/> 
						</many-to-one>
											 					
			
			
		  			
						<many-to-one name="Articulo_pertenece" class="WinetrackerGen.Infraestructure.EN.Winetracker.ArticuloNH" >	
								<column name="FK_id_idArticulo"/> 
						</many-to-one>
											 					
			
			
					
					
					
					
					
		
		 </class>	
		  
		  <query name="LineaPedidoNHReadAllHQL">from LineaPedidoNH</query>
		</hibernate-mapping>
	