@model List<VentaViewModel>
<style>
    .nav-tabs .nav-link.active {
        font-weight: bold;
        color: #000;
        border-color: #dee2e6 #dee2e6 #fff;
        text-decoration: none;
    }

    .img-thumbnail {
        max-width: 100%;
        border-radius: 50%;
    }

    :root {
        --color-primary: #e06666; /* Color principal */
        --color-secondary: #cc0000; /* Rojo intenso */
        --color-accent-light: #d9ead3; /* Verde claro */
        --color-accent-dark: #67F57A; /* Verde oscuro */
        --color-accent-yellow: #fff2cc; /* Amarillo pálido */
        --color-dark: #665151; /* Marrón oscuro */
        --color-light: #ffffff; /* Blanco */
    }

    body {
        font-family: "Times New Roman", Times, serif;
        color: var(--secondary-color);
        background-color: var( --color-accent-yellow);
    }

    a {
        color: var(--accent-color);
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
    }

        .btn-envio:hover {
            background-color: var(--color-accent-dark);
        }

    .btn-danger {
        color: #FFF;
        background-color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .nav-tabs .nav-link.active {
        background-color: var(--primary-color);
        color: var(--light-color);
    }

    .footer {
        background-color: var(--secondary-color);
        color: var(--light-color);
        text-align: center;
        padding: 10px 0;
    }

    h1 {
        font-size: 48px;
        color: var(--primary-color);
    }

    h2 {
        font-size: 36px;
        color: var(--primary-color);
    }

    h3 {
        font-size: 26px;
        color: var(--primary-color);
    }

    p {
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 1em;
    }

    ul {
        list-style-type: disc;
        margin: 0 0 1em 1.5em;
    }

    ol {
        list-style-type: decimal;
        margin: 0 0 1em 1.5em;
    }

    .nav-tabs .nav-link {
        color: var(--secondary-color);
    }

        .nav-tabs .nav-link:hover {
            color: var(--primary-color);
        }

    .img-thumbnail {
        border-radius: 50%;
        max-width: 150px;
        height: auto;
        border: 2px solid var(--primary-color);
    }

    /* Botón de envío con bordes redondeados */
    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
        border-radius: 15px; /* Bordes redondeados */
        padding: 10px 20px;
    }

        .btn-envio:hover {
            background-color: var(--color-accent-dark);
        }

    .btn-info {
        background-color: var(--color-accent-light) !important;
        color: var(--color-dark);
        border-block-color: var(--color-accent-dark) !important;
    }

        .btn-info:hover {
            background-color: var(--color-accent-dark) !important;
            border-block-color: var(--color-accent-light) !important;
            color: var(--color-accent-yellow) !important;
            text-decoration: none;
        }
</style>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/Edit">Mi Perfil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Articulo/MisVinos">Mis Vinos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/MisPedidos">Mis Pedidos (@ViewBag.CantidadPedidos)</a>

                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Mis Ventas (@ViewBag.CantidadPedidos)</a>
                </li>
            </ul>
        </div>
    </div>
    <!-- Mostrar mensajes de éxito o error al principio -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    <h1 class="mb-4">Mis Ventas</h1>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Venta ID</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Pedido Por</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    <tr>
                        <td>@pedido.VentaId</td>
                        <td>@pedido.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@pedido.Estado</td>
                        <td>@pedido.Usuario</td>
                        <td>
                            <a href="@Url.Action("Detalle", "Usuario", new { id = pedido.VentaId })" class="btn btn-info btn-sm">Ver Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>