@model WinetrackerGen.ApplicationCore.EN.Winetracker.UsuarioEN
@using Microsoft.AspNetCore.Http

<style>
    .nav-tabs .nav-link.active {
        font-weight: bold;
        color: #000;
        border-color: #dee2e6 #dee2e6 #fff;
        text-decoration: none;
    }

    .img-thumbnail {
        max-width: 100%;
        border-radius: 50%;
    }

    :root {
        --color-primary: #e06666; /* Color principal */
        --color-secondary: #cc0000; /* Rojo intenso */
        --color-accent-light: #d9ead3; /* Verde claro */
        --color-accent-dark: #67F57A; /* Verde oscuro */
        --color-accent-yellow: #fff2cc; /* Amarillo pálido */
        --color-dark: #665151; /* Marrón oscuro */
        --color-light: #ffffff; /* Blanco */
    }

    body {
        font-family: "Times New Roman", Times, serif;
        color: var(--secondary-color);
        background-color: var( --color-accent-yellow);
    }

    a {
        color: var(--accent-color);
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
    }

        .btn-envio:hover {
            background-color: var(--color-accent-dark);
        }

    .btn-danger {
        color: #fff;
        background-color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .nav-tabs .nav-link.active {
        background-color: var(--primary-color);
        color: var(--light-color);
    }

    .footer {
        background-color: var(--secondary-color);
        color: var(--light-color);
        text-align: center;
        padding: 10px 0;
    }

    h1 {
        font-size: 48px;
        color: var(--primary-color);
    }

    h2 {
        font-size: 36px;
        color: var(--primary-color);
    }

    h3 {
        font-size: 26px;
        color: var(--primary-color);
    }

    p {
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 1em;
    }

    ul {
        list-style-type: disc;
        margin: 0 0 1em 1.5em;
    }

    ol {
        list-style-type: decimal;
        margin: 0 0 1em 1.5em;
    }

    .nav-tabs .nav-link {
        color: var(--secondary-color);
    }

        .nav-tabs .nav-link:hover {
            color: var(--primary-color);
        }

    .img-thumbnail {
        border-radius: 50%;
        max-width: 150px;
        height: auto;
        border: 2px solid var(--primary-color);
    }

    /* Botón de envío con bordes redondeados */
    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
        border-radius: 15px; /* Bordes redondeados */
        padding: 10px 20px;
    }

    .btn-envio:hover {
        background-color: var(--color-accent-dark);
    }
</style>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Mi Perfil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Articulo/MisVinos">Mis Vinos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/MisPedidos">Mis Pedidos (@ViewBag.CantidadPedidos)</a>

                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/MisVentas">Mis Ventas (@ViewBag.CantidadPedidos)</a>
                </li>
            </ul>
        </div>
    </div>
    <h1 class="mb-4">Editar Perfil</h1>
    <div class="row">
        <div class="col-md-4 text-center">
            <div class="mb-3">
                <img src="@Url.Content("~/imagenes/" + Model.Foto)" alt="Foto de perfil" class="img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
            </div>
            <form asp-action="BorrarImagen" method="post">
                <button type="submit" class="btn btn-danger mt-2">Borrar Imagen</button>
            </form>
        </div>

        <div class="col-md-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                <!-- Campo correo no editable -->
                <div class="form-group mb-3">
                    <label for="correo">Correo electrónico</label>
                    <input type="email" id="correo" name="Correo" class="form-control" value="@Model.Correo" readonly />
                </div>

                <!-- Validación de campos vacíos -->
                <div class="form-group mb-3">
                    <label for="nombre">Nombre de usuario</label>
                    <input type="text" id="nombre" name="Nombre" class="form-control" value="@Model.Nombre" required />
                </div>

                <!-- Campo de contraseña vacío -->
                <div class="form-group mb-3">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="Password" class="form-control" placeholder="Nueva contraseña (opcional)" />
                </div>

                <div class="form-group mb-3">
                    <label for="foto">Cambiar Imagen</label>
                    <input type="file" name="foto" id="foto" class="form-control" />
                </div>

                <button type="submit" class="btn-envio">Guardar Cambios</button>
            </form>
        </div>
    </div>
</div>
@if (TempData["Success"] != null)
{
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--color-accent-dark); color: white;">
                    <h5 class="modal-title" id="successModalLabel">Éxito</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @TempData["Success"]
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" style="background-color: var(--color-accent-light); color: var(--color-dark);" data-bs-dismiss="modal">
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var successModal = document.getElementById('successModal');
        if (successModal) {
            var modal = new bootstrap.Modal(successModal);
            modal.show();
        }
    });
</script>
<!-- Modal de Error -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-primary); color: white;">
                <h5 class="modal-title" id="errorModalLabel">Error</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                La contraseña no puede estar vacía. Por favor, introdúcela antes de guardar los cambios.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: var(--color-accent-light); color: var(--color-dark);" data-bs-dismiss="modal">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("editForm").addEventListener("submit", function (event) {
        const nombre = document.getElementById("nombre").value.trim();
        const passwordField = document.getElementById("password");
        let password = passwordField.value.trim();

        // Validar si el nombre está vacío
        if (!nombre) {
            event.preventDefault();
            alert("El nombre de usuario no puede estar vacío.");
            return;
        }

        // Validar si la contraseña está vacía
        if (!password) {
            event.preventDefault();
            // Mostrar modal de error
            var errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
            errorModal.show();
        }
    });
</script>