@model IEnumerable<WebApplication.Models.ArticuloViewModel>

@{
    ViewData["Title"] = "MisVinos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .nav-tabs .nav-link.active {
        font-weight: bold;
        color: #000;
        border-color: #dee2e6 #dee2e6 #fff;
        text-decoration: none;
    }

    .img-thumbnail {
        max-width: 100%;
        border-radius: 50%;
    }

    :root {
        --color-primary: #e06666; /* Color principal */
        --color-secondary: #cc0000; /* Rojo intenso */
        --color-accent-light: #d9ead3; /* Verde claro */
        --color-accent-dark: #67F57A; /* Verde oscuro */
        --color-accent-yellow: #fff2cc; /* Amarillo pálido */
        --color-dark: #665151; /* Marrón oscuro */
        --color-light: #ffffff; /* Blanco */
    }

    body {
        font-family: "Times New Roman", Times, serif;
        color: var(--secondary-color);
        background-color: var( --color-accent-yellow);
    }

    a {
        color: var(--accent-color);
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
    }

        .btn-envio:hover {
            background-color: var(--color-accent-dark);
        }

    .btn-danger {
        color: #fff;
        background-color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .nav-tabs .nav-link.active {
        background-color: var(--primary-color);
        color: var(--light-color);
    }

    .footer {
        background-color: var(--secondary-color);
        color: var(--light-color);
        text-align: center;
        padding: 10px 0;
    }

    h1 {
        font-size: 48px;
        color: var(--primary-color);
    }

    h2 {
        font-size: 36px;
        color: var(--primary-color);
    }

    h3 {
        font-size: 26px;
        color: var(--primary-color);
    }

    p {
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 1em;
    }

    ul {
        list-style-type: disc;
        margin: 0 0 1em 1.5em;
    }

    ol {
        list-style-type: decimal;
        margin: 0 0 1em 1.5em;
    }

    .nav-tabs .nav-link {
        color: var(--secondary-color);
    }

        .nav-tabs .nav-link:hover {
            color: var(--primary-color);
        }

    .img-thumbnail {
        border-radius: 50%;
        max-width: 150px;
        height: auto;
        border: 2px solid var(--primary-color);
    }

    /* Botón de envío con bordes redondeados */
    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
        border-radius: 15px; /* Bordes redondeados */
        padding: 10px 20px;
    }

        .btn-envio:hover {
            background-color: var(--color-accent-dark);
        }
    /* Estilo para los botones Edit, Details y Delete */
    .btn-action {
        display: inline-block;
        padding: 5px 10px !important; /* Espaciado interno */
        background-color: var(--color-accent-light) !important; /* Verde claro */
        color: var(--color-dark) !important; /* Marrón oscuro */
        border: 1px solid var(--color-accent-dark) !important; /* Borde verde oscuro */
        border-radius: 5px !important; /* Bordes redondeados */
        text-decoration: none !important; /* Sin subrayado */
        margin-right: 5px !important; /* Espaciado entre botones */
        font-size: 0.9rem !important; /* Tamaño del texto */
        text-align: center !important;
        transition: background-color 0.3s ease, color 0.3s ease !important;
    }

        .btn-action:hover {
            background-color: var(--color-accent-dark) !important; /* Verde oscuro */
            color: var(--color-light) !important; /* Texto blanco */
            text-decoration: none !important;
        }

    .btn-eliminar {
        background-color: var(--color-accent-dark);
        color: white;
        border: none;
        transition: background-color 0.3s ease;
    }

        .btn-eliminar:hover {
            background-color: #4BC65A; /* Un tono ligeramente más oscuro */
            color: white;
            cursor: pointer;
        }

    .modal-body {
        background-color: var(--color-accent-yellow) !important;
        color: var(--color-dark); /* Texto en color oscuro para contraste */
        border-radius: 5px; /* Opcional: bordes redondeados */
        border-block-color: var(--color-accent-yellow) !important;
    }

    .modal-header {
        background-color: var(--color-accent-yellow) !important;
        color: var(--color-dark) !important; /* Texto en color oscuro para contraste */
        border-radius: 5px; /* Opcional: bordes redondeados */
        border-block-color: var(--color-accent-yellow) !important;
    }

    .modal-footer {
        background-color: var(--color-accent-yellow) !important;
        color: var(--color-dark); /* Texto en color oscuro para contraste */
        border-radius: 5px; /* Opcional: bordes redondeados */
        border-block-color: var(--color-accent-yellow) !important;
    }
</style>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/Edit">Mi Perfil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/Articulo/MisVinos">Mis Vinos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/MisPedidos">Mis Pedidos (@ViewBag.CantidadPedidos)</a>

                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Usuario/MisVentas">Mis Ventas (@ViewBag.CantidadPedidos)</a>
                </li>
            </ul>
        </div>
    </div>

    <h1>MisVinos</h1>

    <p>
        <a asp-action="Create">Create New</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Precio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Stock)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ValoracionMedia)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Precio)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Stock)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ValoracionMedia)
                    </td>

                    <td>
                        <form asp-action="Edit" method="get" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-action">Edit</button>
                        </form>

                        <form asp-action="Detalle" method="get" style="display:inline;">
                            <input type="hidden" name="id" class="btn-action" value="@item.Id" />
                            <button type="submit" class="btn-action">Details</button>
                        </form>

                        <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirmDelete(this);">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="button" class="btn btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-id="@item.Id">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar este artículo?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="confirmDeleteForm" method="post">
                    <input type="hidden" name="id" id="deleteIdInput">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    var deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        // Botón que abre el modal
        var button = event.relatedTarget;

        // Extrae el ID del artículo del atributo data-id
        var articleId = button.getAttribute('data-id');

        // Establece el valor del input oculto en el formulario del modal
        var deleteIdInput = deleteModal.querySelector('#deleteIdInput');
        deleteIdInput.value = articleId;

        // Ajusta la acción del formulario para apuntar al endpoint correcto si es necesario
        var deleteForm = deleteModal.querySelector('#confirmDeleteForm');
        deleteForm.action = `/Articulo/Delete/${articleId}`;
    });
</script>