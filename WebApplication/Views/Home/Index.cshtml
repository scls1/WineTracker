@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .nav-tabs .nav-link.active {
        font-weight: bold;
        color: #000;
        border-color: #dee2e6 #dee2e6 #fff;
        text-decoration: none;
    }

    .img-thumbnail {
        max-width: 100%;
        border-radius: 50%;
    }

    :root {
        --color-primary: #e06666; /* Color principal */
        --color-secondary: #cc0000; /* Rojo intenso */
        --color-accent-light: #d9ead3; /* Verde claro */
        --color-accent-dark: #67F57A; /* Verde oscuro */
        --color-accent-yellow: #fff2cc; /* Amarillo pálido */
        --color-dark: #665151; /* Marrón oscuro */
        --color-light: #ffffff; /* Blanco */
    }

    body {
        font-family: "Times New Roman", Times, serif;
        color: var(--secondary-color);
        background-color: var( --color-accent-yellow);
    }

    a {
        color: var(--color-dark);
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    .btn-envio {
        color: var(--light-color);
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
    }

        .btn-envio:hover {
            background-color: var(--color-primary);
        }

    .btn-danger {
        color: #FFF;
        background-color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .nav-tabs .nav-link.active {
        background-color: var(--primary-color);
        color: var(--light-color);
    }

    .footer {
        background-color: var(--secondary-color);
        color: var(--light-color);
        text-align: center;
        padding: 10px 0;
    }

    h1 {
        font-size: 48px;
        color: var(--color-dark);
    }

    h2 {
        font-size: 36px;
        color: var(--color-dark);
    }

    h3 {
        font-size: 26px;
        color: var(--color-dark);
    }

    p {
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 1em;
    }

    ul {
        list-style-type: disc;
        margin: 0 0 1em 1.5em;
    }

    ol {
        list-style-type: decimal;
        margin: 0 0 1em 1.5em;
    }

    .nav-tabs .nav-link {
        color: var(--secondary-color);
    }

        .nav-tabs .nav-link:hover {
            color: var(--primary-color);
        }

    .img-thumbnail {
        border-radius: 50%;
        max-width: 150px;
        height: auto;
        border: 2px solid var(--primary-color);
    }

    .user-highlight {
        color: #e06666; /* Color rojo para el usuario */
    }
    /* Estilo del botón de precio */
    .price-button {
        position: absolute; /* Posiciona el botón en la parte inferior derecha */
        bottom: 10px; /* Alineado al fondo de la tarjeta */
        right: 10px; /* Alineado a la derecha */
        padding: 10px 15px;
        background-color: var(--color-accent-dark) !important; /* Fondo verde claro */
        color: var(--color-dark); /* Texto oscuro */
        border: none;
        border-radius: 50px; /* Bordes redondeados */
        font-size: 1.2rem;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        /* Efecto de hover para el botón */
        .price-button:hover {
            background-color: var(--color-accent-dark) !important; /* Verde oscuro */
            color: white; /* Texto blanco */
            transform: scale(1.05); /* Agrandar ligeramente el botón */
        }
    /* Estilo para el modal */
    #sessionSuccessModal .modal-header {
        background-color: var(--color-accent-dark) !important; /* Verde oscuro */
        color: white; /* Texto blanco */
        border-bottom: none;
    }

    #sessionSuccessModal .modal-content {
        border: 2px solid var(--color-accent-dark) !important; /* Marco verde oscuro */
    }

    /* Estilo del botón principal */
    #sessionSuccessModal .btn-success {
        background-color: var(--color-accent-light) !important; /* Verde claro */
        color: var(--color-dark) !important; /* Texto oscuro */
        border-color: var(--color-accent-dark) !important; /* Borde verde oscuro */
    }

        #sessionSuccessModal .btn-success:hover {
            background-color: var(--color-accent-dark) !important; /* Verde oscuro */
            color: white !important; /* Texto blanco */
            border-color: var(--color-accent-light) !important; /* Borde verde claro */
        }

    /* Estilo del botón de cerrar */
    #sessionSuccessModal .btn-close {
        color: white !important;
    }
</style>

<!-- Barra de enumerados -->
<div class="enumerated-bar mt-3 mb-4">
    <div class="filter-container">
        <!-- Filtro de tipo Vino -->
        <div class="filter-item @((ViewData["TipoVino"] != null) ? "selected" : "")">
            <img src="@Url.Content("~/iconos/copa-con-vino.png")" alt="Vino" class="iconos" />
            <span>Vinos</span>
            <div class="filter-dropdown">
                @foreach (var tipoVino in Enum.GetValues(typeof(WinetrackerGen.ApplicationCore.Enumerated.Winetracker.VinosEnum)))
                {
                    <a href="#" class="filter-option" data-filter="tipoVino" data-value="@((int)tipoVino)"
                    @if (ViewData["TipoVino"] != null && ViewData["TipoVino"].ToString() == ((int)tipoVino).ToString())
                    {
                        <text> style="background-color: #007bff; color: white;" </text>
                    }>
                        @tipoVino
                            </a>
                }
            </div>
        </div>

        <!-- Filtro de tipo Uva -->
        <div class="filter-item @((ViewData["TipoUva"] != null) ? "selected" : "")">
            <img src="@Url.Content("~/iconos/uvas.png")" alt="Uva" class="iconos" />
            <span>Uva</span>
            <div class="filter-dropdown">
                @foreach (var tipoUva in Enum.GetValues(typeof(WinetrackerGen.ApplicationCore.Enumerated.Winetracker.UvasEnum)))
                {
                    <a href="#" class="filter-option" data-filter="tipoUva" data-value="@((int)tipoUva)"
                    @if (ViewData["TipoUva"] != null && ViewData["TipoUva"].ToString() == ((int)tipoUva).ToString())
                    {
                        <text> style="background-color: #007bff; color: white;" </text>
                    }>
                        @tipoUva
                            </a>
                }
            </div>
        </div>

        <!-- Filtro de Maridaje -->
        <div class="filter-item @((ViewData["Maridaje"] != null) ? "selected" : "")">
            <img src="@Url.Content("~/iconos/vino.png")" alt="Maridaje" class="iconos" />
            <span>Maridaje</span>
            <div class="filter-dropdown">
                @foreach (var maridaje in Enum.GetValues(typeof(WinetrackerGen.ApplicationCore.Enumerated.Winetracker.MaridajeEnum)))
                {
                    <a href="#" class="filter-option" data-filter="maridaje" data-value="@((int)maridaje)"
                    @if (ViewData["Maridaje"] != null && ViewData["Maridaje"].ToString() == ((int)maridaje).ToString())
                    {
                        <text> style="background-color: #007bff; color: white;" </text>
                    }>
                        @maridaje
                            </a>
                }
            </div>
        </div>

        <!-- Filtro de Regiones -->
        <div class="filter-item @((ViewData["Region"] != null) ? "selected" : "")">
            <img src="@Url.Content("~/iconos/localizacion-gps.png")" alt="Región" class="iconos" />
            <span>Región</span>
            <div class="filter-dropdown">
                @foreach (var region in Enum.GetValues(typeof(WinetrackerGen.ApplicationCore.Enumerated.Winetracker.RegionEnum)))
                {
                    <a href="#" class="filter-option" data-filter="region" data-value="@((int)region)"
                    @if (ViewData["Region"] != null && ViewData["Region"].ToString() == ((int)region).ToString())
                    {
                        <text> style="background-color: #007bff; color: white;" </text>
                    }>
                        @region
                            </a>
                }
            </div>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Limpiar filtros</a>
    </div>

    <h3 style= "margin-top: 10px;">
        Bienvenid&#64; a Winetracker,
        <span class="user-highlight">@ViewBag.User</span>
    </h3>

    <!-- Grilla de artículos -->
    <div class="container mt-4">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <a href="@Url.Action("Detalle", "Articulo", new { id = item.Id })" class="text-decoration-none">
                        <div class="card h-100 shadow">
                            <img src="@Url.Content("~/imagenes/" + item.Foto)" class="card-img-top pt-3" alt="@item.Nombre">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title text-danger mb-2">@item.Nombre</h5>
                                    <p class="card-text text-secondary">
                                        <div class="me-2 d-flex">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Floor(@item.ValoracionMedia)) // Redondear hacia abajo para las estrellas completas
                                                {
                                                    <i class="bi bi-star-fill me-1" style="color: gold; font-size: 1.5rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star me-1" style="color: gold; font-size: 1.5rem;"></i>
                                                }
                                            }
                                        </div>
                                    </p>
                                    <p class="card-text text-secondary">@item.Region</p>
                                </div>
                                <!-- Aquí ya no necesitamos el precio, lo moveremos a un botón con posicionamiento absoluto -->
                            </div>
                            <!-- Botón con el precio, ahora estará abajo derecha -->
                            <button class="price-button">@item.Precio €</button>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
<!-- Modal de sesión iniciada con éxito -->
<div class="modal fade" id="sessionSuccessModal" tabindex="-1" aria-labelledby="sessionSuccessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="sessionSuccessModalLabel">Éxito</h5>
                <button type="button" class="btn-close text-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @TempData["Success"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Script para mostrar el modal si TempData contiene el mensaje -->
@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var myModal = new bootstrap.Modal(document.getElementById('sessionSuccessModal'));
            myModal.show();
        });
    </script>
}

<style>
    .filter-bar {
        gap: 10px; /* Espacio entre los elementos */
        justify-content: space-between; /* Distribuir los elementos */
    }

        .filter-bar .dropdown {
            flex: 1; /* Todos los dropdowns ocupan el mismo espacio */
            min-width: 150px; /* Asegurar un tamaño mínimo */
        }

        .filter-bar .form-select {
            width: 100%; /* Hacer que el select ocupe todo el espacio */
            border-radius: 0.25rem;
        }

    /* Estilo de la tarjeta de vino */
    /* Estilo para la imagen dentro de la tarjeta */
    .card-img-top {
        width: 100%; /* Asegura que la imagen ocupe todo el ancho de la tarjeta */
        height: 400px; /* Establece una altura fija para la imagen */
        object-fit: cover; /* Asegura que la imagen se recorte o se ajuste para cubrir el área sin distorsionarse */
        object-position: center; /* Centra la imagen dentro del área definida */
    }

    /* Estilo de la tarjeta de vino */
    .card {
        position: relative;
        transition: transform 0.3s ease-in-out;
    }

        /* Efecto de hover para la tarjeta */
        .card:hover {
            transform: scale(1.05); /* Agranda ligeramente la tarjeta */
        }

    /* Estilo del botón de precio */
    .price-button {
        position: absolute; /* Posiciona el botón en la parte inferior derecha */
        bottom: 10px; /* Alineado al fondo de la tarjeta */
        right: 10px; /* Alineado a la derecha */
        padding: 10px 15px;
        background-color: #28a745; /* Fondo verde */
        color: white;
        border: none;
        border-radius: 50px; /* Bordes redondeados */
        font-size: 1.2rem;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        /* Efecto de hover para el precio */
        .price-button:hover {
            background-color: #218838; /* Color más oscuro al pasar el ratón */
            transform: scale(1.05); /* Agrandar ligeramente el botón */
        }

    /* Filtros - Barra horizontal */
    .filter-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        width: 100%;
    }

    .filter-item {
        position: relative;
        padding: 8px 15px;
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 5px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 150px;
    }

    .iconos {
        width: 20px;
        height: 20px;
    }

    .filter-item span {
        font-size: 14px;
    }

    .filter-item:hover {
        background-color: #d9ead3;
        color: #665151;
    }

    .filter-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 300px; /* Ancho de la caja desplegable */
        max-height: 300px; /* Altura máxima de la caja */
        background-color: white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd;
        border-radius: 5px;
        overflow-y: auto;
        z-index: 100;
        padding: 10px;
    }

    .filter-item:hover .filter-dropdown {
        display: block;
    }

    .filter-item.selected {
        background-color: #67F57A; /* Fondo verde */
        color: white; /* Texto blanco */
        border-color: #218838; /* Borde más oscuro */
    }

    .filter-option {
        display: block;
        padding: 8px;
        color: #333;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
    }

        .filter-option:hover,
        .filter-option:focus {
            background-color: #67F57A; /* Verde al pasar el ratón */
            color: white;
        }

    .filter-item.selected {
        background-color: #28a745; /* Verde principal */
        color: white; /* Texto blanco */
        border-color: #218838; /* Verde oscuro para borde */
    }

    .filter-option:hover,
    .filter-option:focus {
        background-color: #28a745; /* Verde */
        color: white;
    }

</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filterOptions = document.querySelectorAll(".filter-option");
        const filterItems = document.querySelectorAll(".filter-item");

        filterOptions.forEach(option => {
            option.addEventListener("click", function (e) {
                e.preventDefault();

                const filterType = e.target.dataset.filter;
                const filterValue = e.target.dataset.value;

                // Actualizar la URL con el filtro seleccionado
                const url = new URL(window.location.href);
                url.searchParams.set(filterType, filterValue);
                window.location.href = url.toString(); // Realiza el cambio en la URL y recarga la página

                // Agregar la clase 'selected' al contenedor del filtro
                filterItems.forEach(item => {
                    // Limpiar la clase 'selected' de todos los filtros
                    item.classList.remove("selected");

                    // Verificar si el filtro actual coincide con el seleccionado
                    const dropdownOptions = item.querySelectorAll(".filter-option");
                    dropdownOptions.forEach(opt => {
                        if (opt.dataset.value == filterValue) {
                            item.classList.add("selected");  // Agregar la clase 'selected' al filtro
                        }
                    });
                });
            });
        });
    });
</script>