<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
            font-family: "Times New Roman", Times, serif; /* Fuente aplicada al cuerpo */
        }

        .navbar {
            padding: 10px 20px;
            background-color: #d9ead3; /* Fondo verde claro */
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: bold;
            color: #333;
            text-transform: uppercase;
        }

            .navbar-brand:hover {
                color: #e06666; /* Verde destacado */
                text-decoration: none; /* Sin subrayado */
            }

        .search-bar input {
            border-radius: 20px;
            padding: 10px 20px;
            border: 1px solid #ddd;
            width: 100%;
            transition: all 0.3s;
            font-family: "Times New Roman", Times, serif; /* Fuente aplicada al input */
        }

            .search-bar input:focus {
                border-color: #67F57A;
                box-shadow: 0 0 5px rgba(103, 245, 122, 0.5);
                outline: none;
            }

        .icon-buttons a, .icon-buttons button {
            background: none;
            border: none;
            color: #6c757d; /* Color inicial */
            font-size: 1.5rem;
            transition: color 0.3s ease;
            text-decoration: none; /* Sin subrayado */
            font-family: "Times New Roman", Times, serif; /* Fuente aplicada a iconos */
        }

            .icon-buttons a:hover, .icon-buttons button:hover {
                color: #e06666; /* Verde destacado */
                text-decoration: none; /* Sin subrayado */
            }
    </style>
</head>
<body>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - WebApplication - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
